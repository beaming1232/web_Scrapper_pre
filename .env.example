# Copy this file to `.env` and fill in real values for your environment.
# All variables map 1:1 onto fields in config.py::Settings (uppercase env
# var -> lowercase field name is handled automatically by pydantic-settings).

# --- Database ---------------------------------------------------------------
# Async SQLAlchemy connection string. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_aggregator
# Log every SQL statement (debug only, noisy). true/false.
DB_ECHO=false
# SQLAlchemy connection pool size / overflow.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Scraping / networking ---------------------------------------------------
# Timeout (seconds) for a source's fetch() HTTP calls.
REQUEST_TIMEOUT_SECONDS=15
# Timeout (seconds) for HEAD-based apply URL redirect resolution.
URL_RESOLVE_TIMEOUT_SECONDS=5
# Fallback rate limit / delay used when a source doesn't set its own
# requests_per_minute / crawl_delay_seconds.
DEFAULT_REQUESTS_PER_MINUTE=20
DEFAULT_CRAWL_DELAY_SECONDS=1.0
# JSON array of User-Agent strings to rotate between requests. Optional -
# a sensible default pool is baked into config.py if omitted.
# USER_AGENTS=["Mozilla/5.0 ...", "Mozilla/5.0 ..."]

# --- Scheduler (APScheduler cron expressions) ---------------------------------
SCRAPE_CRON_SCHEDULE=0 */6 * * *
HEALTH_CHECK_CRON_SCHEDULE=0 3 * * *

# --- API (Phase 3, api/) -------------------------------------------------------
# JSON array of allowed CORS origins for the read-only API. "*" is fine for
# local dev; narrow to the real frontend origin(s) before deploying publicly.
CORS_ORIGINS=["*"]

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- AI description rewriting (Phase 2, pipeline/rewriter.py) -----------------
# Gemini API key. Leave empty to disable AI rewriting entirely — jobs are
# still stored, just with rewritten_description left NULL.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest
# -1 = dynamic/"Auto" thinking (model decides how much to reason per request).
GEMINI_THINKING_BUDGET=-1
REWRITE_ENABLED=true
REWRITE_TIMEOUT_SECONDS=30
REWRITE_MAX_RETRIES=2
REWRITE_MAX_CONCURRENCY=3
REWRITE_TEMPERATURE=0.3
